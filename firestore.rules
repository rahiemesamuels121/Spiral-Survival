rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function live(data) { return data.expiresAt > request.time; }
    function validName(name) { return name is string && name.size() > 0 && name.size() <= 16; }
    function roomKeys(data) {
      return data.keys().hasOnly(['hostId', 'members', 'playerOrder', 'status', 'revision',
        'boardId', 'state', 'outcome', 'activeUid', 'lastRequestId', 'lastError',
        'hostSeen', 'createdAt', 'expiresAt']);
    }
    function membership(data) {
      return data.members is map && data.playerOrder is list &&
        data.members.size() >= 1 && data.members.size() <= 5 &&
        data.playerOrder.size() == data.members.size() &&
        data.playerOrder.toSet() == data.members.keys().toSet() &&
        data.hostId in data.members;
    }
    match /rooms/{code} {
      // Codes are private invitations. Directory/list queries are never allowed.
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && code.matches('^[A-HJ-NP-Z2-9]{8}$') &&
        roomKeys(request.resource.data) && membership(request.resource.data) &&
        request.resource.data.hostId == request.auth.uid &&
        request.resource.data.members.keys().hasOnly([request.auth.uid]) &&
        validName(request.resource.data.members[request.auth.uid]) &&
        request.resource.data.playerOrder == [request.auth.uid] &&
        request.resource.data.status == 'waiting' && request.resource.data.revision == 0 &&
        request.resource.data.activeUid == '' && request.resource.data.state == '' &&
        request.resource.data.outcome == '' && request.resource.data.lastRequestId == '' &&
        request.resource.data.lastError == '' && request.resource.data.boardId is string &&
        request.resource.data.boardId.size() < 100 &&
        request.resource.data.createdAt == request.time && request.resource.data.hostSeen == request.time &&
        request.resource.data.expiresAt > request.time &&
        request.resource.data.expiresAt <= request.time + duration.value(25, 'h');

      function onlyMembershipChanged() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'playerOrder']);
      }
      function join() {
        return live(resource.data) && resource.data.status == 'waiting' &&
          !(request.auth.uid in resource.data.members) && resource.data.members.size() < 5 &&
          onlyMembershipChanged() && membership(request.resource.data) &&
          request.resource.data.members.diff(resource.data.members).affectedKeys().hasOnly([request.auth.uid]) &&
          request.resource.data.members.size() == resource.data.members.size() + 1 &&
          validName(request.resource.data.members[request.auth.uid]) &&
          request.resource.data.playerOrder == resource.data.playerOrder.concat([request.auth.uid]);
      }
      function leaveLobby() {
        return resource.data.status == 'waiting' && request.auth.uid != resource.data.hostId &&
          request.auth.uid in resource.data.members && onlyMembershipChanged() && membership(request.resource.data) &&
          request.resource.data.members.diff(resource.data.members).affectedKeys().hasOnly([request.auth.uid]) &&
          !(request.auth.uid in request.resource.data.members) &&
          request.resource.data.playerOrder == resource.data.playerOrder.removeAll([request.auth.uid]);
      }
      function hostUpdate() {
        return request.auth.uid == resource.data.hostId && roomKeys(request.resource.data) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'revision', 'state', 'outcome', 'activeUid', 'lastRequestId', 'lastError', 'hostSeen']) &&
          request.resource.data.status in ['waiting', 'playing', 'closed'] &&
          (request.resource.data.status == resource.data.status ||
            resource.data.status == 'waiting' && request.resource.data.status == 'playing' && resource.data.members.size() >= 2 ||
            request.resource.data.status == 'closed') &&
          request.resource.data.revision is int &&
          request.resource.data.revision >= resource.data.revision &&
          request.resource.data.revision <= resource.data.revision + 1 &&
          request.resource.data.state is string && request.resource.data.state.size() <= 65536 &&
          request.resource.data.outcome is string && request.resource.data.outcome.size() <= 8192 &&
          request.resource.data.lastRequestId is string && request.resource.data.lastRequestId.size() <= 128 &&
          request.resource.data.lastError is string && request.resource.data.lastError.size() <= 256 &&
          request.resource.data.hostSeen == request.time &&
          (request.resource.data.status != 'playing' ||
            live(resource.data) && request.resource.data.activeUid in resource.data.playerOrder);
      }
      allow update: if signedIn() && (join() || leaveLobby() || hostUpdate());
      allow delete: if signedIn() && request.auth.uid == resource.data.hostId;

      match /requests/{playerId} {
        function room() { return get(/databases/$(database)/documents/rooms/$(code)).data; }
        allow read: if signedIn() && (request.auth.uid == room().hostId || request.auth.uid == playerId && request.auth.uid in room().members);
        allow create, update: if signedIn() && request.auth.uid == playerId &&
          request.auth.uid in room().members &&
          (room().activeUid == request.auth.uid || request.resource.data.action == 'playerIcon') &&
          room().status == 'playing' && live(room()) &&
          request.resource.data.keys().hasOnly(['requestId', 'action', 'args', 'expectedRevision', 'createdAt']) &&
          request.resource.data.requestId is string && request.resource.data.requestId.size() <= 128 &&
          request.resource.data.action in ['roll', 'move', 'review', 'event', 'hospital', 'healthPack', 'police', 'portal', 'buy', 'medicalBuy', 'attack', 'shopDone', 'endTurn', 'playerIcon'] &&
          request.resource.data.args is map && request.resource.data.args.keys().hasOnly(['pay', 'card', 'weapon', 'target', 'item', 'icon']) &&
          (request.resource.data.action != 'playerIcon' ||
            request.resource.data.args.keys().hasOnly(['icon']) &&
            request.resource.data.args.icon in ['number', 'star', 'rocket', 'shield', 'paw', 'bolt', 'diamond', 'flag']) &&
          request.resource.data.expectedRevision == room().revision &&
          request.resource.data.createdAt == request.time;
        allow delete: if signedIn() && request.auth.uid == room().hostId;
      }
    }
    match /{document=**} { allow read, write: if false; }
  }
}
